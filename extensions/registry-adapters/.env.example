# Read by RegistryAdapterSettings. Prefix is registry_adapters_.
# Set the same values on the Celery worker and the staff API.

REGISTRY_ADAPTERS_CONNECTOR=db

REGISTRY_ADAPTERS_DB_DRIVER=postgresql
REGISTRY_ADAPTERS_DB_USERNAME=postgres
REGISTRY_ADAPTERS_DB_PASSWORD=postgres
REGISTRY_ADAPTERS_DB_HOSTNAME=localhost
REGISTRY_ADAPTERS_DB_PORT=5432
REGISTRY_ADAPTERS_DB_DBNAME=socialregistrydb

REGISTRY_ADAPTERS_PARTNER_API_URL=http://localhost:8000
REGISTRY_ADAPTERS_PARTNER_API_TIMEOUT=30
REGISTRY_ADAPTERS_PARTNER_API_SSL_VERIFY=true
REGISTRY_ADAPTERS_FARMER_REG_TYPE=Farmer
REGISTRY_ADAPTERS_HOUSEHOLD_REG_TYPE=Household
REGISTRY_ADAPTERS_FARMER_REG_RECORD_TYPE=Farmer
REGISTRY_ADAPTERS_HOUSEHOLD_REG_RECORD_TYPE=Household
